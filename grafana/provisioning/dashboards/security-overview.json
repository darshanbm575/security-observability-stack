{
  "title": "Security Overview",
  "uid": "security-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Auth failure rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(app_auth_failures_total[5m])",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "401/403 rate by source",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (source_ip) (rate(app_http_requests_total{status=~\"401|403\"}[5m]))",
          "legendFormat": "{{source_ip}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Container restarts",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "increase(container_start_time_seconds[10m])",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Auth log stream",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{job=\"auth\"}"
        }
      ]
    }
  ]
}
